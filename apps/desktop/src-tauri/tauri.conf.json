{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Industrial Design",
  "mainBinaryName": "open-industrial-design-desktop",
  "version": "../../../package.json",
  "identifier": "com.openindustrialdesign.desktop",
  "build": { "frontendDist": "../../web/dist" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: http: blob:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "license": "MPL-2.0",
    "resources": {
      "../native-review/NATIVE-NOTICES.txt": "NATIVE-NOTICES.txt",
      "Cargo.lock": "Cargo.lock",
      "../../../LICENSE": "LICENSE.txt"
    },
    "shortDescription": "Local-first industrial design workspace",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false },
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
